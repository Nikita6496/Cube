# ============================================================
# .gitignore для проекта "Антикафе КУБ"
# Node.js + Express + MySQL
# ============================================================

# ---------- Node.js ----------
node_modules/
jspm_packages/

# ---------- Логи ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ---------- Секреты и окружение ----------
# Реальный .env не коммитим — там пароль от БД
.env
.env.*
# А вот шаблон .env.example — коммитим, чтобы препод видел,
# какие переменные нужны для запуска
!.env.example

# ---------- Кэши ----------
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.cache/
.parcel-cache/

# ---------- Диагностика Node ----------
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ---------- OS (Windows / macOS / Linux) ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- IDE ----------
# .vscode/ в целом не коммитим, но рекомендованные расширения — можно
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ---------- Временные файлы ----------
*.tmp
*.temp